# Copy to .env.docker when running the full stack (`docker compose --profile app up`).
# For infra-only (MySQL + Redis) with API on host, use backend/.env with DB_HOST=127.0.0.1.

SERVER_PORT=8080
SERVER_ENV=development

DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=lumi_marketplace

JWT_SECRET=change-me-in-development
JWT_EXPIRY=24h

MAX_UPLOAD_SIZE=10485760

# Cloudinary (used by the API container for image uploads)
# WARNING: Never commit real credentials. Replace placeholders with real values in .env (gitignored).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Lumi Africa

RESEND_API_KEY=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/callback
PAYSTACK_TIMEOUT=30s

REDIS_ENABLED=true
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

SWAGGER_ENABLED=true
